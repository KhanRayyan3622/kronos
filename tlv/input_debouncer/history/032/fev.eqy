############################################
# GOLDEN DESIGN
############################################
[gold]
read_verilog -sv -formal feved.sv

############################################
# UPDATED / GATE DESIGN
############################################
[gate]
read_verilog -sv -formal wip.sv

[script]
#chparam -set ...
#prep -top input_debouncer -flatten
hierarchy -top input_debouncer -check
flatten
proc -ifx
#splitnets -ports
clean
setundef -anyseq
#sim -w -clock clk -reset reset -rstlen 10 -n 10


############################################
# MATCHING / PARTITIONING HINTS
############################################
# The below section should be formatted as:
# [match input_debouncer]
gold-match gpio_gen[0].raw_val |default/gpio[0]<>0$raw_val
gold-match gpio_gen[0].line |default/gpio[0]<>0$line
gold-match gpio_gen[0].poll |default/gpio[0]<>0$poll
gold-match gpio_gen[1].raw_val |default/gpio[1]<>0$raw_val
gold-match gpio_gen[1].line |default/gpio[1]<>0$line
gold-match gpio_gen[1].poll |default/gpio[1]<>0$poll
gold-match gpio_gen[2].raw_val |default/gpio[2]<>0$raw_val
gold-match gpio_gen[2].line |default/gpio[2]<>0$line
gold-match gpio_gen[2].poll |default/gpio[2]<>0$poll
gold-match gpio_gen[3].raw_val |default/gpio[3]<>0$raw_val
gold-match gpio_gen[3].line |default/gpio[3]<>0$line
gold-match gpio_gen[3].poll |default/gpio[3]<>0$poll
gold-match gpio_gen[4].raw_val |default/gpio[4]<>0$raw_val
gold-match gpio_gen[4].line |default/gpio[4]<>0$line
gold-match gpio_gen[4].poll |default/gpio[4]<>0$poll
gold-match gpio_gen[5].raw_val |default/gpio[5]<>0$raw_val
gold-match gpio_gen[5].line |default/gpio[5]<>0$line
gold-match gpio_gen[5].poll |default/gpio[5]<>0$poll
gold-match gpio_gen[6].raw_val |default/gpio[6]<>0$raw_val
gold-match gpio_gen[6].line |default/gpio[6]<>0$line
gold-match gpio_gen[6].poll |default/gpio[6]<>0$poll
gold-match gpio_gen[7].raw_val |default/gpio[7]<>0$raw_val
gold-match gpio_gen[7].line |default/gpio[7]<>0$line
gold-match gpio_gen[7].poll |default/gpio[7]<>0$poll
gold-match gpio_gen[8].raw_val |default/gpio[8]<>0$raw_val
gold-match gpio_gen[8].line |default/gpio[8]<>0$line
gold-match gpio_gen[8].poll |default/gpio[8]<>0$poll
gold-match gpio_gen[9].raw_val |default/gpio[9]<>0$raw_val
gold-match gpio_gen[9].line |default/gpio[9]<>0$line
gold-match gpio_gen[9].poll |default/gpio[9]<>0$poll
gold-match gpio_gen[10].raw_val |default/gpio[10]<>0$raw_val
gold-match gpio_gen[10].line |default/gpio[10]<>0$line
gold-match gpio_gen[10].poll |default/gpio[10]<>0$poll
gold-match gpio_gen[11].raw_val |default/gpio[11]<>0$raw_val
gold-match gpio_gen[11].line |default/gpio[11]<>0$line
gold-match gpio_gen[11].poll |default/gpio[11]<>0$poll
gold-match gpio_gen[12].raw_val |default/gpio[12]<>0$raw_val
gold-match gpio_gen[12].line |default/gpio[12]<>0$line
gold-match gpio_gen[12].poll |default/gpio[12]<>0$poll
gold-match gpio_gen[13].raw_val |default/gpio[13]<>0$raw_val
gold-match gpio_gen[13].line |default/gpio[13]<>0$line
gold-match gpio_gen[13].poll |default/gpio[13]<>0$poll
gold-match gpio_gen[14].raw_val |default/gpio[14]<>0$raw_val
gold-match gpio_gen[14].line |default/gpio[14]<>0$line
gold-match gpio_gen[14].poll |default/gpio[14]<>0$poll
gold-match gpio_gen[15].raw_val |default/gpio[15]<>0$raw_val
gold-match gpio_gen[15].line |default/gpio[15]<>0$line
gold-match gpio_gen[15].poll |default/gpio[15]<>0$poll
gold-match DEFAULT_Gpio_sync_a0[0] |default/gpio[0]<>0$sync
gold-match DEFAULT_Gpio_sync_a0[1] |default/gpio[1]<>0$sync
gold-match DEFAULT_Gpio_sync_a0[2] |default/gpio[2]<>0$sync
gold-match DEFAULT_Gpio_sync_a0[3] |default/gpio[3]<>0$sync
gold-match DEFAULT_Gpio_sync_a0[4] |default/gpio[4]<>0$sync
gold-match DEFAULT_Gpio_sync_a0[5] |default/gpio[5]<>0$sync
gold-match DEFAULT_Gpio_sync_a0[6] |default/gpio[6]<>0$sync
gold-match DEFAULT_Gpio_sync_a0[7] |default/gpio[7]<>0$sync
gold-match DEFAULT_Gpio_sync_a0[8] |default/gpio[8]<>0$sync
