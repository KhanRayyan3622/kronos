############################################
# GOLDEN DESIGN
############################################
[gold]
read_verilog -sv -formal feved.sv

############################################
# UPDATED / GATE DESIGN
############################################
[gate]
read_verilog -sv -formal wip.sv

[script]
#chparam -set ...
#prep -top input_debouncer -flatten
hierarchy -top input_debouncer -check
flatten
proc -ifx
#splitnets -ports
clean
setundef -anyseq
#sim -w -clock clk -reset reset -rstlen 10 -n 10


############################################
# MATCHING / PARTITIONING HINTS
############################################
# The below section should be formatted as:
# [match input_debouncer]
# gold-match <gold_signal> <gate_signal>
# ...
# And should be followed by a blank line, marking the end of the section.
# Gate names may use TL-Verilog pipesignal references, which will be mapped by `fev.sh`.
[match input_debouncer]
gold-match gpio[0].raw_val |default/gpio[0]<>0$raw_val
gold-match gpio[0].line |default/gpio[0]<>0$line
gold-match gpio[0].poll |default/gpio[0]<>0$poll
gold-match gpio[1].raw_val |default/gpio[1]<>0$raw_val
gold-match gpio[1].line |default/gpio[1]<>0$line
gold-match gpio[1].poll |default/gpio[1]<>0$poll
gold-match gpio[2].raw_val |default/gpio[2]<>0$raw_val
gold-match gpio[2].line |default/gpio[2]<>0$line
gold-match gpio[2].poll |default/gpio[2]<>0$poll
gold-match gpio[3].raw_val |default/gpio[3]<>0$raw_val
gold-match gpio[3].line |default/gpio[3]<>0$line
gold-match gpio[3].poll |default/gpio[3]<>0$poll
gold-match gpio[4].raw_val |default/gpio[4]<>0$raw_val
gold-match gpio[4].line |default/gpio[4]<>0$line
gold-match gpio[4].poll |default/gpio[4]<>0$poll
gold-match gpio[5].raw_val |default/gpio[5]<>0$raw_val
gold-match gpio[5].line |default/gpio[5]<>0$line
gold-match gpio[5].poll |default/gpio[5]<>0$poll
gold-match gpio[6].raw_val |default/gpio[6]<>0$raw_val
gold-match gpio[6].line |default/gpio[6]<>0$line
gold-match gpio[6].poll |default/gpio[6]<>0$poll
gold-match gpio[7].raw_val |default/gpio[7]<>0$raw_val
gold-match gpio[7].line |default/gpio[7]<>0$line
gold-match gpio[7].poll |default/gpio[7]<>0$poll
gold-match gpio[8].raw_val |default/gpio[8]<>0$raw_val
gold-match gpio[8].line |default/gpio[8]<>0$line
gold-match gpio[8].poll |default/gpio[8]<>0$poll
gold-match gpio[9].raw_val |default/gpio[9]<>0$raw_val
gold-match gpio[9].line |default/gpio[9]<>0$line
gold-match gpio[9].poll |default/gpio[9]<>0$poll
gold-match gpio[10].raw_val |default/gpio[10]<>0$raw_val
gold-match gpio[10].line |default/gpio[10]<>0$line
gold-match gpio[10].poll |default/gpio[10]<>0$poll
gold-match gpio[11].raw_val |default/gpio[11]<>0$raw_val
gold-match gpio[11].line |default/gpio[11]<>0$line
gold-match gpio[11].poll |default/gpio[11]<>0$poll
gold-match gpio[12].raw_val |default/gpio[12]<>0$raw_val
gold-match gpio[12].line |default/gpio[12]<>0$line
gold-match gpio[12].poll |default/gpio[12]<>0$poll
gold-match gpio[13].raw_val |default/gpio[13]<>0$raw_val
gold-match gpio[13].line |default/gpio[13]<>0$line
gold-match gpio[13].poll |default/gpio[13]<>0$poll
gold-match gpio[14].raw_val |default/gpio[14]<>0$raw_val
gold-match gpio[14].line |default/gpio[14]<>0$line
gold-match gpio[14].poll |default/gpio[14]<>0$poll
gold-match gpio[15].raw_val |default/gpio[15]<>0$raw_val
gold-match gpio[15].line |default/gpio[15]<>0$line
gold-match gpio[15].poll |default/gpio[15]<>0$poll
gold-match gpio[0].sync |default/gpio[0]<>0$sync
gold-match gpio[1].sync |default/gpio[1]<>0$sync
gold-match gpio[2].sync |default/gpio[2]<>0$sync
gold-match gpio[3].sync |default/gpio[3]<>0$sync
gold-match gpio[4].sync |default/gpio[4]<>0$sync
gold-match gpio[5].sync |default/gpio[5]<>0$sync
gold-match gpio[6].sync |default/gpio[6]<>0$sync
gold-match gpio[7].sync |default/gpio[7]<>0$sync
gold-match gpio[8].sync |default/gpio[8]<>0$sync
gold-match gpio[9].sync |default/gpio[9]<>0$sync
gold-match gpio[10].sync |default/gpio[10]<>0$sync
gold-match gpio[11].sync |default/gpio[11]<>0$sync
gold-match gpio[12].sync |default/gpio[12]<>0$sync
gold-match gpio[13].sync |default/gpio[13]<>0$sync
gold-match gpio[14].sync |default/gpio[14]<>0$sync
gold-match gpio[15].sync |default/gpio[15]<>0$sync

[collect *]
# Let EQY partition automatically.
# If you want to force grouping by register name patterns, you can uncomment:
# group *

[partition *]
# It can be useful to group outputs to avoid output cut points if outputs are used internally.
#name outputs ^o_.*


############################################
# STRATEGIES
############################################
# Disabled due to https://github.com/YosysHQ/eqy/issues/83
#[strategy fast_sat]
#use sat
#depth 10

[strategy sby_seq]
use sby
depth 20
engine smtbmc
